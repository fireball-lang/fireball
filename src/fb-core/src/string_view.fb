mod core;

pub struct StringView {
	pub ptr: *u8,
	pub size: u32,
}

impl StringView {
	pub func starts_with(self, other: StringView) bool {
		if (self.size < other.size) return false;

		return self.slice(0u, other.size).eq(other);
	}

	pub func ends_with(self, other: StringView) bool {
		if (self.size < other.size) return false;

		return self.slice(self.size - other.size, self.size).eq(other);
	}

	pub func contains(self, other: StringView) bool {
		return self.index_of(other) != -1;
	}

	pub func trim(self) StringView {
		var start = 0u;
		var end = self.size;

		while (start < self.size && (self.ptr[start] == ' ' || self.ptr[start] == '\t' || self.ptr[start] == '\n')) {
			start++;
		}

		while (end - 1u >= 0u && (self.ptr[end - 1u] == ' ' || self.ptr[end - 1u] == '\t' || self.ptr[end - 1u] == '\n')) {
			end--;
		}

		return self.slice(start, end);
	}

	pub func index_of(self, other: StringView) i32 {
		if (other.size == 0u) return 0;
		if (self.size < other.size) return -1;

		var last = self.size - other.size;

		for (var i = 0u; i <= last; i++) {
			if (self.slice(i, i + other.size).eq(other)) {
				return (i as i32);
			}
		}

		return -1;
	}

	pub func index_of_last(self, other: StringView) i32 {
		if (other.size == 0u) return (self.size as i32);
		if (self.size < other.size) return -1;

		var last = self.size - other.size;

		for (var i = last; ; i--) {
			if (self.slice(i, i + other.size).eq(other)) {
				return (i as i32);
			}

			if (i == 0u) {
				break;
			}
		}

		return -1;
	}

	pub func slice(self, start: u32, end: u32) StringView {
		var view: StringView;
		view.ptr = &self.ptr[start];
		view.size = end - start;

		return view;
	}
}

impl StringView : Eq {
    pub func eq(self, rhs: StringView) bool {
		if (self.size != rhs.size) return false;

		for (var i = 0u; i < rhs.size; i++) {
			if (self.ptr[i] != rhs.ptr[i]) return false;
		}

		return true;
	}
}

impl StringView : Index[u32] {
	type Result = u8;

	pub func index(self, idx: u32) u8 {
		return self.ptr[idx];
	}
}
