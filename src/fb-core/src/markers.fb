mod core;

// Zeroable

/// This is a marker interface (meaning it has no methods) that is automatically implemented on types by the compiler.
/// Types that implement this interface can be zero-initialized by variables with no initializers.
/// - Primitives, Pointers, Enums, Functions and Interfaces are always `Zeroable`.
/// - Arrays are `Zeroable` if their inner type is `Zeroable`.
/// - Structs are `Zeroable` if all their fields are `Zeroable`.
pub interface Zeroable {}
