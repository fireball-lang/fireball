mod core;

var panic_handler: func(msg: StringView);

func set_panic_handler(handler: func(msg: StringView)) {
	panic_handler = handler;
}

/// Produces an unrecoverable error which is forwarded to a set panic handler after which the execution of a program stops.
func panic(msg: StringView) {
	if (panic_handler == null) {
		for (;;) {}
	}

	panic_handler(msg);
}
