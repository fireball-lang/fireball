mod core;

// Immutable

/// An immutable sequence of `T` with a known size.
pub struct Slice[T] {
	pub ptr: *T,
	pub size: u64,
}

impl[T] Slice[T] {
	pub func is_empty(self) bool {
		return self.size == 0u;
	}

	pub func first(self) ?T {
		if (self.size == 0u) return Option:[T]::none();
		return self.ptr[0];
	}

	pub func last(self) ?T {
		if (self.size == 0u) return Option:[T]::none();
		return self.ptr[self.size - 1u];
	}

	pub func slice(self, start: u64, end: u64) []T {
		return Self {
			ptr: &self.ptr[start],
			size: end - start,
		};
	}

	pub func offset(self, start: u64) []T {
		return self.slice(start, self.size);
	}
}

impl[T: Eq[T]] Slice[T] {
	pub func index_of(self, value: T) ?u64 {
		for (var i = 0u; i < self.size; i++) {
			if (self.ptr[i].eq(value)) return i;
		}

		return Option:[u64]::none();
	}

	pub func contains(self, value: T) bool {
		return self.index_of(value).is_some();
	}
}

impl[T: Eq[T]] Slice[T] : Eq[Slice[T]] {
	pub func eq(self, other: Self) bool {
		if (self.size != other.size) return false;

		for (var i = 0u; i < self.size; i++) {
			if (!self.ptr[i].eq(other.ptr[i])) return false;
		}

		return true;
	}
}

impl[T] Slice[T] : Index[u64] {
	type Result = T;

	pub func index(self, i: u64) T {
		return self.ptr[i];
	}
}

// Mutable

/// A mutable sequence of `T` with a known size.
pub struct MutSlice[T] {
	pub ptr: mut *T,
	pub size: u64,
}

impl[T] MutSlice[T] {
	pub func is_empty(self) bool {
		return self.size == 0u;
	}

	pub func first(self) ?T {
		if (self.size == 0u) return Option:[T]::none();
		return self.ptr[0];
	}

	pub func last(self) ?T {
		if (self.size == 0u) return Option:[T]::none();
		return self.ptr[self.size - 1u];
	}

	pub func slice(self, start: u64, end: u64) mut []T {
		return Self {
			ptr: &self.ptr[start],
			size: end - start,
		};
	}

	pub func offset(self, start: u64) mut []T {
		return self.slice(start, self.size);
	}
}

impl[T] MutSlice[T] {
	pub func fill(mut self, value: T) {
		for (var i = 0u; i < self.size; i++) {
			self.ptr[i] = value;
		}
	}

	pub func swap(mut self, a: u64, b: u64) {
		var temp = self.ptr[a];
		self.ptr[a] = self.ptr[b];
		self.ptr[b] = temp;
	}

	pub func reverse(mut self) {
		for (var i = 0u; i < self.size / 2u; i++) {
			self.swap(i, self.size - 1u - i);
		}
	}
}

impl[T: Eq[T]] MutSlice[T] {
	pub func index_of(self, value: T) ?u64 {
		for (var i = 0u; i < self.size; i++) {
			if (self.ptr[i].eq(value)) return i;
		}

		return Option:[u64]::none();
	}

	pub func contains(self, value: T) bool {
		return self.index_of(value).is_some();
	}
}

impl[T: Eq[T]] MutSlice[T] : Eq[Slice[T]] {
	pub func eq(self, other: Slice[T]) bool {
		if (self.size != other.size) return false;

		for (var i = 0u; i < self.size; i++) {
			if (!self.ptr[i].eq(other.ptr[i])) return false;
		}

		return true;
	}
}

impl[T] MutSlice[T] : Index[u64] {
	type Result = T;

	pub func index(self, i: u64) T {
		return self.ptr[i];
	}
}

impl[T] MutSlice[T] : ImplicitAs[Slice[T]] {
	pub func implicit_as(self) Slice[T] {
		return Slice:[T] { ptr: self.ptr, size: self.size };
	}
}
