mod core;

// Eq

/// Implementing this interface overrides the `==` and `!=` operators for the concrete type and a pointer to that type.
pub interface Eq[T] {
    func eq(self, rhs: T) bool;
}

impl bool : Eq[bool] {
    pub func eq(self, rhs: Self) bool { return *self == rhs; }
}

impl u8 : Eq[u8] {
    pub func eq(self, rhs: Self) bool { return *self == rhs; }
}
impl u16 : Eq[u16] {
    pub func eq(self, rhs: Self) bool { return *self == rhs; }
}
impl u32 : Eq[u32] {
    pub func eq(self, rhs: Self) bool { return *self == rhs; }
}
impl u64 : Eq[u64] {
    pub func eq(self, rhs: Self) bool { return *self == rhs; }
}

impl i8 : Eq[i8] {
    pub func eq(self, rhs: Self) bool { return *self == rhs; }
}
impl i16 : Eq[i16] {
    pub func eq(self, rhs: Self) bool { return *self == rhs; }
}
impl i32 : Eq[i32] {
    pub func eq(self, rhs: Self) bool { return *self == rhs; }
}
impl i64 : Eq[i64] {
    pub func eq(self, rhs: Self) bool { return *self == rhs; }
}

impl f32 : Eq[f32] {
    pub func eq(self, rhs: Self) bool { return *self == rhs; }
}
impl f64 : Eq[f64] {
    pub func eq(self, rhs: Self) bool { return *self == rhs; }
}

// Ord

/// Implementing this interface overrides the `<`, `<=`, `>` and `>=` operators for the concrete type and a pointer to that type.
pub enum Ordering {
	Less,
	Equal,
	Greater,
}

pub interface Ord[T] {
	func ord(self, rhs: T) Ordering;
}

impl u8 : Ord[u8] {
	func ord(self, rhs: Self) Ordering {
		if (*self == rhs) return Ordering::Equal;
		if (*self < rhs) return Ordering::Less;
		return Ordering::Greater;
	}
}
impl u16 : Ord[u16] {
	func ord(self, rhs: Self) Ordering {
		if (*self == rhs) return Ordering::Equal;
		if (*self < rhs) return Ordering::Less;
		return Ordering::Greater;
	}
}
impl u32 : Ord[u32] {
	func ord(self, rhs: Self) Ordering {
		if (*self == rhs) return Ordering::Equal;
		if (*self < rhs) return Ordering::Less;
		return Ordering::Greater;
	}
}
impl u64 : Ord[u64] {
	func ord(self, rhs: Self) Ordering {
		if (*self == rhs) return Ordering::Equal;
		if (*self < rhs) return Ordering::Less;
		return Ordering::Greater;
	}
}

impl i8 : Ord[i8] {
	func ord(self, rhs: Self) Ordering {
		if (*self == rhs) return Ordering::Equal;
		if (*self < rhs) return Ordering::Less;
		return Ordering::Greater;
	}
}
impl i16 : Ord[i16] {
	func ord(self, rhs: Self) Ordering {
		if (*self == rhs) return Ordering::Equal;
		if (*self < rhs) return Ordering::Less;
		return Ordering::Greater;
	}
}
impl i32 : Ord[i32] {
	func ord(self, rhs: Self) Ordering {
		if (*self == rhs) return Ordering::Equal;
		if (*self < rhs) return Ordering::Less;
		return Ordering::Greater;
	}
}
impl i64 : Ord[i64] {
	func ord(self, rhs: Self) Ordering {
		if (*self == rhs) return Ordering::Equal;
		if (*self < rhs) return Ordering::Less;
		return Ordering::Greater;
	}
}

impl f32 : Ord[f32] {
	func ord(self, rhs: Self) Ordering {
		if (*self == rhs) return Ordering::Equal;
		if (*self < rhs) return Ordering::Less;
		return Ordering::Greater;
	}
}
impl f64 : Ord[f64] {
	func ord(self, rhs: Self) Ordering {
		if (*self == rhs) return Ordering::Equal;
		if (*self < rhs) return Ordering::Less;
		return Ordering::Greater;
	}
}

// Not

/// Implementing this interface overrides the `!` operator for the concrete type and a pointer to that type.
pub interface Not {
	type Result;

	func not(self) Result;
}

impl bool : Not {
	type Result = bool;
	pub func not(self) Self { return !*self; }
}

// BitNot

/// Implementing this interface overrides the `~` operator for the concrete type and a pointer to that type.
pub interface BitNot {
	type Result;

	func bit_not(self) Result;
}

impl i8 : BitNot {
	type Result = i8;
	pub func bit_not(self) Self { return ~*self; }
}
impl i16 : BitNot {
	type Result = i16;
	pub func bit_not(self) Self { return ~*self; }
}
impl i32 : BitNot {
	type Result = i32;
	pub func bit_not(self) Self { return ~*self; }
}
impl i64 : BitNot {
	type Result = i64;
	pub func bit_not(self) Self { return ~*self; }
}

impl u8 : BitNot {
	type Result = u8;
	pub func bit_not(self) Self { return ~*self; }
}
impl u16 : BitNot {
	type Result = u16;
	pub func bit_not(self) Self { return ~*self; }
}
impl u32 : BitNot {
	type Result = u32;
	pub func bit_not(self) Self { return ~*self; }
}
impl u64 : BitNot {
	type Result = u64;
	pub func bit_not(self) Self { return ~*self; }
}

