{
    "name": "fireball",
    "displayName": "fireball",
    "description": "General-purpose programming language that compiles to efficient native binaries.",
    "version": "0.0.1",
    "repository": "https://github.com/MineGame159/fireball/tree/rewrite",
    "engines": {
        "vscode": "^1.100.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "languages": [
            {
                "id": "fireball",
                "aliases": [
                    "Fireball",
                    "fireball"
                ],
                "extensions": [
                    ".fb"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "fireball",
                "scopeName": "source.fb",
                "path": "./syntaxes/fireball.tmLanguage.json"
            }
        ]
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./"
    },
    "devDependencies": {
        "@types/node": "^22.15.24",
        "@types/vscode": "^1.100.0",
        "typescript": "^5.8.3"
    },
    "dependencies": {
        "vscode-languageclient": "^9.0.1"
    }
}
