mod tests;

#[test]
func orShortCircuit() bool {
	var test = true;
	true || (test = false);

	return test;
}

#[test]
func nestedAnd() bool {
	return true && true && true;
}

#[test]
func andShortCircuit() bool {
	var test = true;
	false && (test = false);

	return test;
}

#[test]
func nestedOr() bool {
	return false || false || true;
}

#[test]
func numberLiterals() bool {
	var s1: i32 = 5;
	var s2: i64 = -3000000000;

	var u1: u32 = 5u;
	var u2: u64 = 5000000000U;

	var f1: f32 = 5f;
	var f2: f32 = 5.f;
	var f3: f32 = 5.0f;

	var d1: f64 = 5.;
	var d2: f64 = 5.0;

	var h1: u32 = 0x00Ba6;
	var h2: u64 = 0XFFFFF00Ba6;

	var b1: u32 = 0b10100001;
	var b2: u64 = 0B1111010101010101010101000010100001;

	return true;
}

#[test]
func characterLiteral() bool {
	var c0 = '\0';
	var c1 = '\a';
	var c2 = '\b';
	var c3 = '\f';
	var c4 = '\n';
	var c5 = '\r';
	var c6 = '\t';
	var c7 = '\v';
	var c8 = '\\';
	var c9 = '\'';

	return '\n' == 10 as u8 && '\'' == 39 as u8;
}

#[test]
func stringLiteral() bool {
	"\a \b \f \n \r \t \v \\ \"";
	"\023 \255";
	"\x0F \xa3";

	return true;
}

#[test]
func increment() bool {
	var a = 1;
	var b = a++;

	a = 1;
	var c = ++a;

	return b == 1 && c == 2;
}

#[test]
func decrement() bool {
	var a = 1;
	var b = a--;

	a = 1;
	var c = --a;

	return b == 1 && c == 0;
}

var number i32;

#[test]
func globalVariable() bool {
	number = 7;
	return number == 7;
}

#[test]
func shiftLeftSigned() bool {
	return (-1 << 2) == -4;
}

#[test]
func shiftLeftUnsigned() bool {
	return (1u << 2u) == 4u;
}

#[test]
func shiftRightSigned() bool {
	return (-4 >> 2) == -1;
}

#[test]
func shiftRightUnsigned() bool {
	return (4u >> 2u) == 1u;
}
