mod tests::ops;

// Types

struct Vec2 {
	x: i32,
	y: i32,
}

impl Vec2 {
	func new(x: i32, y: i32) Vec2 {
		return Vec2 { x: x, y: y };
	}
}

struct Vec3 {
	x: i32,
	y: i32,
	z: i32,
}

// Eq

impl Vec2 : Eq[Vec2] {
	pub func eq(self, rhs: Vec2) bool {
		return self.x == rhs.x && self.y == rhs.y;
	}
}

#[test("core::Eq[T] - equal")]
func eqVec2Equal() bool {
	return Vec2::new(1, 2) == Vec2::new(1, 2);
}

#[test("core::Eq[T] - not equal")]
func eqVec2NotEqual() bool {
	return Vec2::new(1, 2) != Vec2::new(3, 4);
}

#[test("core::Eq[T] - different x")]
func eqVec2DiffX() bool {
	return Vec2::new(1, 2) != Vec2::new(3, 2);
}

#[test("core::Eq[T] - different y")]
func eqVec2DiffY() bool {
	return Vec2::new(1, 2) != Vec2::new(1, 4);
}

// Ord

impl Vec2 : Ord[Vec2] {
	pub func ord(self, rhs: Vec2) Ordering {
		if (self.x == rhs.x && self.y == rhs.y) return Ordering::Equal;
		if (self.x < rhs.x || (self.x == rhs.x && self.y < rhs.y)) return Ordering::Less;
		return Ordering::Greater;
	}
}

#[test("core::Ord[T] - less by x")]
func ordVec2LessX() bool {
	return Vec2::new(1, 2) < Vec2::new(2, 2);
}

#[test("core::Ord[T] - greater by x")]
func ordVec2GreaterX() bool {
	return Vec2::new(2, 2) > Vec2::new(1, 2);
}

#[test("core::Ord[T] - less by y")]
func ordVec2LessY() bool {
	return Vec2::new(1, 2) < Vec2::new(1, 3);
}

#[test("core::Ord[T] - greater by y")]
func ordVec2GreaterY() bool {
	return Vec2::new(1, 3) > Vec2::new(1, 2);
}

#[test("core::Ord[T] - less or equal by x")]
func ordVec2LessEqualX() bool {
	return Vec2::new(1, 2) <= Vec2::new(2, 2);
}

#[test("core::Ord[T] - greater or equal by x")]
func ordVec2GreaterEqualX() bool {
	return Vec2::new(2, 2) >= Vec2::new(1, 2);
}

#[test("core::Ord[T] - less or equal by y")]
func ordVec2LessEqualY() bool {
	return Vec2::new(1, 2) <= Vec2::new(1, 3);
}

#[test("core::Ord[T] - greater or equal by y")]
func ordVec2GreaterEqualY() bool {
	return Vec2::new(1, 3) >= Vec2::new(1, 2);
}

#[test("core::Ord[T] - equal")]
func ordVec2Equal() bool {
	return Vec2::new(1, 2) <= Vec2::new(1, 2) && Vec2::new(1, 2) >= Vec2::new(1, 2);
}

#[test("core::Ord[T] - not less or equal")]
func ordVec2NotLessEqual() bool {
	return !(Vec2::new(2, 2) <= Vec2::new(1, 2));
}

#[test("core::Ord[T] - not greater or equal")]
func ordVec2NotGreaterEqual() bool {
	return !(Vec2::new(1, 2) >= Vec2::new(2, 2));
}

// Not

impl Vec2 : Not {
    type Result = Vec2;

	pub func not(self) Vec2 {
		return Vec2 { x: self.x ^ 0xFFFFFFFF as i32, y: self.y ^ 0xFFFFFFFF as i32 };
	}
}

#[test("core::Not - bitwise not")]
func notVec2() bool {
	var v = !Vec2::new(1, 2);
	return v.x == -2 && v.y == -3;
}

// Neg

impl Vec2 : Neg {
    type Result = Vec2;

	pub func neg(self) Vec2 {
		return Vec2 { x: -self.x, y: -self.y };
	}
}

#[test("core::Neg - negation")]
func negVec2() bool {
	var v = -Vec2::new(1, 2);
	return v.x == -1 && v.y == -2;
}

#[test("core::Neg - double negation")]
func negVec2Double() bool {
	var v = -(-Vec2::new(1, 2));
	return v.x == 1 && v.y == 2;
}

// Add

impl Vec2 : Add[Vec2] {
	type Result = Vec2;

	pub func add(self, rhs: Vec2) Vec2 {
		return Vec2 { x: self.x + rhs.x, y: self.y + rhs.y };
	}
}

#[test("core::Add[T] - addition")]
func addVec2() bool {
	var v = Vec2::new(1, 2) + Vec2::new(3, 4);
	return v.x == 4 && v.y == 6;
}

#[test("core::Add[T] - add zero")]
func addVec2Zero() bool {
	var v = Vec2::new(1, 2) + Vec2::new(0, 0);
	return v.x == 1 && v.y == 2;
}

#[test("core::Add[T] - compound add")]
func compoundAddVec2() bool {
	var v = Vec2::new(1, 2);
	v += Vec2::new(3, 4);
	return v.x == 4 && v.y == 6;
}

// Sub

impl Vec2 : Sub[Vec2] {
	type Result = Vec2;

	pub func sub(self, rhs: Vec2) Vec2 {
		return Vec2 { x: self.x - rhs.x, y: self.y - rhs.y };
	}
}

#[test("core::Sub[T] - subtraction")]
func subVec2() bool {
	var v = Vec2::new(5, 6) - Vec2::new(3, 4);
	return v.x == 2 && v.y == 2;
}

#[test("core::Sub[T] - sub self")]
func subVec2Self() bool {
	var v = Vec2::new(5, 6) - Vec2::new(5, 6);
	return v.x == 0 && v.y == 0;
}

#[test("core::Sub[T] - compound sub")]
func compoundSubVec2() bool {
	var v = Vec2::new(5, 6);
	v -= Vec2::new(3, 4);
	return v.x == 2 && v.y == 2;
}

// Mul

impl Vec2 : Mul[Vec2] {
	type Result = Vec2;

	pub func mul(self, rhs: Vec2) Vec2 {
		return Vec2 { x: self.x * rhs.x, y: self.y * rhs.y };
	}
}

#[test("core::Mul[T] - multiplication")]
func mulVec2() bool {
	var v = Vec2::new(2, 3) * Vec2::new(4, 5);
	return v.x == 8 && v.y == 15;
}

#[test("core::Mul[T] - multiply by one")]
func mulVec2One() bool {
	var v = Vec2::new(2, 3) * Vec2::new(1, 1);
	return v.x == 2 && v.y == 3;
}

#[test("core::Mul[T] - compound mul")]
func compoundMulVec2() bool {
	var v = Vec2::new(2, 3);
	v *= Vec2::new(4, 5);
	return v.x == 8 && v.y == 15;
}

// Div

impl Vec2 : Div[Vec2] {
	type Result = Vec2;

	pub func div(self, rhs: Vec2) Vec2 {
		return Vec2 { x: self.x / rhs.x, y: self.y / rhs.y };
	}
}

#[test("core::Div[T] - division")]
func divVec2() bool {
	var v = Vec2::new(8, 15) / Vec2::new(4, 5);
	return v.x == 2 && v.y == 3;
}

#[test("core::Div[T] - divide by one")]
func divVec2One() bool {
	var v = Vec2::new(8, 15) / Vec2::new(1, 1);
	return v.x == 8 && v.y == 15;
}

#[test("core::Div[T] - compound div")]
func compoundDivVec2() bool {
	var v = Vec2::new(8, 15);
	v /= Vec2::new(4, 5);
	return v.x == 2 && v.y == 3;
}

// Rem

impl Vec2 : Rem[Vec2] {
	type Result = Vec2;

	pub func rem(self, rhs: Vec2) Vec2 {
		return Vec2 { x: self.x % rhs.x, y: self.y % rhs.y };
	}
}

#[test("core::Rem[T] - remainder")]
func remVec2() bool {
	var v = Vec2::new(7, 10) % Vec2::new(3, 4);
	return v.x == 1 && v.y == 2;
}

#[test("core::Rem[T] - no remainder")]
func remVec2None() bool {
	var v = Vec2::new(6, 8) % Vec2::new(3, 4);
	return v.x == 0 && v.y == 0;
}

#[test("core::Rem[T] - compound rem")]
func compoundRemVec2() bool {
	var v = Vec2::new(7, 10);
	v %= Vec2::new(3, 4);
	return v.x == 1 && v.y == 2;
}

// BitOr

impl Vec2 : BitOr[Vec2] {
	type Result = Vec2;

	pub func bit_or(self, rhs: Vec2) Vec2 {
		return Vec2 { x: self.x | rhs.x, y: self.y | rhs.y };
	}
}

#[test("core::BitOr[T] - bitwise or")]
func bitOrVec2() bool {
	var v = Vec2::new(0b1010 as i32, 0b1100 as i32) | Vec2::new(0b1001 as i32, 0b0110 as i32);
	return v.x == 0b1011 as i32 && v.y == 0b1110 as i32;
}

#[test("core::BitOr[T] - compound or")]
func compoundBitOrVec2() bool {
	var v = Vec2::new(0b1010 as i32, 0b1100 as i32);
	v |= Vec2::new(0b1001 as i32, 0b0110 as i32);
	return v.x == 0b1011 as i32 && v.y == 0b1110 as i32;
}

// BitAnd

impl Vec2 : BitAnd[Vec2] {
	type Result = Vec2;

	pub func bit_and(self, rhs: Vec2) Vec2 {
		return Vec2 { x: self.x & rhs.x, y: self.y & rhs.y };
	}
}

#[test("core::BitAnd[T] - bitwise and")]
func bitAndVec2() bool {
	var v = Vec2::new(0b1010 as i32, 0b1100 as i32) & Vec2::new(0b1001 as i32, 0b0110 as i32);
	return v.x == 0b1000 as i32 && v.y == 0b0100 as i32;
}

#[test("core::BitAnd[T] - compound and")]
func compoundBitAndVec2() bool {
	var v = Vec2::new(0b1010 as i32, 0b1100 as i32);
	v &= Vec2::new(0b1001 as i32, 0b0110 as i32);
	return v.x == 0b1000 as i32 && v.y == 0b0100 as i32;
}

// BitXor

impl Vec2 : BitXor[Vec2] {
	type Result = Vec2;

	pub func bit_xor(self, rhs: Vec2) Vec2 {
		return Vec2 { x: self.x ^ rhs.x, y: self.y ^ rhs.y };
	}
}

#[test("core::BitXor[T] - bitwise xor")]
func bitXorVec2() bool {
	var v = Vec2::new(0b1010 as i32, 0b1100 as i32) ^ Vec2::new(0b1001 as i32, 0b0110 as i32);
	return v.x == 0b0011 as i32 && v.y == 0b1010 as i32;
}

#[test("core::BitXor[T] - compound xor")]
func compoundBitXorVec2() bool {
	var v = Vec2::new(0b1010 as i32, 0b1100 as i32);
	v ^= Vec2::new(0b1001 as i32, 0b0110 as i32);
	return v.x == 0b0011 as i32 && v.y == 0b1010 as i32;
}

// Index

impl Vec2 : Index[i32] {
	type Result = i32;

	pub func index(self, i: i32) &i32 {
	    if (i == 0) return &self.x;
		return &self.y;
	}
}

#[test("core::Index[T] - struct temp")]
func indexStructTemp() bool {
	return Vec2::new(1, 2)[1] == 2;
}

#[test("core::Index[T] - struct var")]
func indexStructVar() bool {
	var point = Vec2::new(1, 2);

	return point[1] == 2;
}

#[test("core::Index[T] - struct reference")]
func indexStructReference() bool {
	var point = Vec2::new(1, 2);
	var ref = &point as &Vec2;

	return ref[1] == 2;
}

#[test("core::Index[T] - struct pointer")]
func indexStructPointer() bool {
	var point = Vec2::new(1, 2);
	var ptr = &point as *Vec2;

	return ptr[1] == 2;
}

func genericIndex[T](a: *T, i: i32) T {
	return a[i];
}

#[test("generic ptr index - element type implements Index")]
func genericPtrIndexVarIndex() bool {
	var a = Vec2::new(1, 2);
	return genericIndex:[Vec2](&a as *Vec2, 0).x == 1;
}

// IndexMut

impl Vec2 : IndexMut[i32] {
	type Result = i32;

	pub func index_mut(mut self, i: i32) mut &i32 {
	    if (i == 0) return &self.x;
		return &self.y;
	}
}

#[test("core::IndexMut[T] - struct var")]
func indexMutStructVar() bool {
	var point = Vec2::new(1, 2);

	point[1] = 4;

	return point.y == 4;
}

#[test("core::IndexMut[T] - struct mutable reference")]
func indexMutStructMutReference() bool {
	var point = Vec2::new(1, 2);
	var ref = &point as mut &Vec2;

	ref[1] = 4;

	return point.y == 4;
}

#[test("core::IndexMut[T] - struct mutable pointer")]
func indexMutStructPointer() bool {
	var point = Vec2::new(1, 2);
	var ptr = &point as mut *Vec2;

	ptr[1] = 4;

	return point.y == 4;
}

// Index through reference / pointer call results (non-lvalue bases)

func refVec2(v: &Vec2) &Vec2 {
	return v;
}

func mutRefVec2(v: mut &Vec2) mut &Vec2 {
	return v;
}

func ptrVec2(v: *Vec2) *Vec2 {
	return v;
}

func mutPtrVec2(v: mut *Vec2) mut *Vec2 {
	return v;
}

#[test("core::Index[T] - immutable reference call result")]
func indexImmutableRefResult() bool {
	var point = Vec2::new(1, 2);
	return refVec2(&point)[1] == 2;
}

#[test("core::Index[T] - address of immutable reference call result")]
func indexImmutableRefResultAddress() bool {
	var point = Vec2::new(1, 2);
	var p = &refVec2(&point)[1];
	return *p == 2;
}

#[test("core::Index[T] - immutable pointer call result")]
func indexImmutablePtrResult() bool {
	var point = Vec2::new(1, 2);
	return ptrVec2(&point as *Vec2)[1] == 2;
}

#[test("core::IndexMut[T] - mutable reference call result assign")]
func indexMutRefResultAssign() bool {
	var point = Vec2::new(1, 2);
	mutRefVec2(&point)[1] = 4;
	return point.y == 4;
}

#[test("core::IndexMut[T] - mutable reference call result compound assign")]
func indexMutRefResultCompoundAssign() bool {
	var point = Vec2::new(1, 2);
	mutRefVec2(&point)[1] += 5;
	return point.y == 7;
}

#[test("core::IndexMut[T] - mutable reference call result increment")]
func indexMutRefResultIncrement() bool {
	var point = Vec2::new(1, 2);
	mutRefVec2(&point)[1]++;
	return point.y == 3;
}

#[test("core::IndexMut[T] - address of mutable reference call result")]
func indexMutRefResultAddress() bool {
	var point = Vec2::new(1, 2);
	var p = &mutRefVec2(&point)[1];
	*p = 7;
	return point.y == 7;
}

#[test("core::IndexMut[T] - mutable pointer call result assign")]
func indexMutPtrResultAssign() bool {
	var point = Vec2::new(1, 2);
	mutPtrVec2(&point as mut *Vec2)[1] = 9;
	return point.y == 9;
}

#[test("core::IndexMut[T] - address of mutable pointer call result")]
func indexMutPtrResultAddress() bool {
	var point = Vec2::new(1, 2);
	var p = &mutPtrVec2(&point as mut *Vec2)[1];
	*p = 7;
	return point.y == 7;
}

// Nested index

struct Vec2Row {
	a: Vec2,
	b: Vec2,
}

impl Vec2Row : Index[i32] {
	type Result = Vec2;

	pub func index(self, i: i32) &Vec2 {
		if (i == 0) return &self.a;
		return &self.b;
	}
}

impl Vec2Row : IndexMut[i32] {
	type Result = Vec2;

	pub func index_mut(mut self, i: i32) mut &Vec2 {
		if (i == 0) return &self.a;
		return &self.b;
	}
}

func mutRefVec2Row(v: mut &Vec2Row) mut &Vec2Row {
	return v;
}

func mutPtrVec2Row(v: mut *Vec2Row) mut *Vec2Row {
	return v;
}

#[test("core::Index[T] - nested read")]
func indexNestedRead() bool {
	var m = Vec2Row { a: Vec2::new(1, 2), b: Vec2::new(3, 4) };
	return m[1][1] == 4;
}

#[test("core::IndexMut[T] - nested write")]
func indexNestedWrite() bool {
	var m = Vec2Row { a: Vec2::new(1, 2), b: Vec2::new(3, 4) };
	m[0][1] = 9;
	return m.a.y == 9;
}

#[test("core::IndexMut[T] - nested compound assign")]
func indexNestedCompoundAssign() bool {
	var m = Vec2Row { a: Vec2::new(1, 2), b: Vec2::new(3, 4) };
	m[0][1] += 5;
	return m.a.y == 7;
}

#[test("core::IndexMut[T] - nested increment")]
func indexNestedIncrement() bool {
	var m = Vec2Row { a: Vec2::new(1, 2), b: Vec2::new(3, 4) };
	m[0][1]++;
	return m.a.y == 3;
}

#[test("core::IndexMut[T] - nested address")]
func indexNestedAddress() bool {
	var m = Vec2Row { a: Vec2::new(1, 2), b: Vec2::new(3, 4) };
	var p = &m[0][1];
	*p = 7;
	return m.a.y == 7;
}

#[test("core::Index[T] - nested read through immutable reference")]
func indexNestedRefRead() bool {
	var m = Vec2Row { a: Vec2::new(1, 2), b: Vec2::new(3, 4) };
	var r = &m as &Vec2Row;
	return r[1][0] == 3;
}

#[test("core::IndexMut[T] - nested write through mutable reference")]
func indexNestedMutRefWrite() bool {
	var m = Vec2Row { a: Vec2::new(1, 2), b: Vec2::new(3, 4) };
	var r = &m as mut &Vec2Row;
	r[1][0] = 8;
	return m.b.x == 8;
}

#[test("core::IndexMut[T] - nested write through mutable pointer")]
func indexNestedMutPtrWrite() bool {
	var m = Vec2Row { a: Vec2::new(1, 2), b: Vec2::new(3, 4) };
	var p = &m as mut *Vec2Row;
	p[1][0] = 8;
	return m.b.x == 8;
}

#[test("core::IndexMut[T] - nested write through mutable reference call result")]
func indexNestedMutRefResultWrite() bool {
	var m = Vec2Row { a: Vec2::new(1, 2), b: Vec2::new(3, 4) };
	mutRefVec2Row(&m)[1][0] = 8;
	return m.b.x == 8;
}

#[test("core::IndexMut[T] - nested write through mutable pointer call result")]
func indexNestedMutPtrResultWrite() bool {
	var m = Vec2Row { a: Vec2::new(1, 2), b: Vec2::new(3, 4) };
	mutPtrVec2Row(&m as mut *Vec2Row)[1][0] = 8;
	return m.b.x == 8;
}

#[test("core::IndexMut[T] - nested write with subscript index")]
func indexNestedSubscriptWrite() bool {
	var m = Vec2Row { a: Vec2::new(1, 2), b: Vec2::new(3, 4) };
	var arr = [1]i32 { 1 };
	var ids = arr as []i32;
	m[ids[0]][0] = 8;
	return m.b.x == 8;
}

// Field writes through an indexer

#[test("core::IndexMut[T] - field read via indexer")]
func indexMemberRead() bool {
	var m = Vec2Row { a: Vec2::new(1, 2), b: Vec2::new(3, 4) };
	return m[1].y == 4;
}

#[test("core::IndexMut[T] - field write via indexer")]
func indexMemberWrite() bool {
	var m = Vec2Row { a: Vec2::new(1, 2), b: Vec2::new(3, 4) };
	m[1].y = 9;
	return m.b.y == 9;
}

#[test("core::IndexMut[T] - field compound assign via indexer")]
func indexMemberCompoundAssign() bool {
	var m = Vec2Row { a: Vec2::new(1, 2), b: Vec2::new(3, 4) };
	m[1].y += 5;
	return m.b.y == 9;
}

#[test("core::IndexMut[T] - field increment via indexer")]
func indexMemberIncrement() bool {
	var m = Vec2Row { a: Vec2::new(1, 2), b: Vec2::new(3, 4) };
	m[1].y++;
	return m.b.y == 5;
}

#[test("core::IndexMut[T] - address of field via indexer")]
func indexMemberAddress() bool {
	var m = Vec2Row { a: Vec2::new(1, 2), b: Vec2::new(3, 4) };
	var p = &m[1].y;
	*p = 7;
	return m.b.y == 7;
}

// Mutable method calls through an indexer

impl Vec2 {
	func set_y(mut self, y: i32) {
		self.y = y;
	}
}

#[test("mutable method via mutable reference indexer")]
func mutableMethodThroughMutableRefIndexer() bool {
	var b = Vec2Row { a: Vec2::new(1, 2), b: Vec2::new(3, 4) };
	var r = &b as mut &Vec2Row;
	r[1].set_y(9);
	return b.b.y == 9;
}

#[test("mutable method via mutable reference field")]
func mutableMethodThroughMutableRefField() bool {
	var b = Vec2Row { a: Vec2::new(1, 2), b: Vec2::new(3, 4) };
	var r = &b as mut &Vec2Row;
	r.a.set_y(9);
	return b.a.y == 9;
}

#[test("read method via immutable reference indexer")]
func readMethodThroughImmutableRefIndexer() bool {
	var b = Vec2Row { a: Vec2::new(1, 2), b: Vec2::new(3, 4) };
	var r = &b as &Vec2Row;
	return r[1].y == 4;
}

// ImplicitAs

impl Vec2 : ImplicitAs[Vec3] {
	pub func implicit_as(self) Vec3 {
		return Vec3 { x: self.x, y: self.y };
	}
}

#[test("core::ImplicitAs[T]")]
func implicitAsStruct() bool {
	var point3: Vec3 = Vec2::new(2, 3);
	return point3.y == 3;
}

// ImplicitAs cast from a constrained type parameter

func implicit_as_param[T: ImplicitAs[Vec3]](v: T) Vec3 {
	return v as Vec3;
}

#[test("ImplicitAs cast on a constrained type parameter")]
func implicitAsParam() bool {
	var point3 = implicit_as_param:[Vec2](Vec2::new(2, 3));
	return point3.y == 3 && point3.z == 0;
}

struct Wrap[T] {
	value: T,
}

impl[T: ImplicitAs[Vec3]] Wrap[T] {
	pub func to_vec(self) Vec3 {
		return self.value as Vec3;
	}
}

#[test("ImplicitAs cast on a constrained type param inside an impl")]
func implicitAsImplParam() bool {
	var wrap = Wrap:[Vec2] { value: Vec2::new(4, 5) };
	var point3 = wrap.to_vec();
	return point3.x == 4 && point3.y == 5;
}

// A type whose only Eq conformance is on a type it is implicitly castable to.
// It must still satisfy the `Eq[T]` constraint, mirroring how `String` satisfies
// `Eq[String]` through its `Eq[StringView]` + `ImplicitAs[StringView]` impls.

struct Alpha {
	x: i32,
	y: i32,
}

struct Beta {
	x: i32,
	y: i32,
}

impl Beta : Eq[Alpha] {
	pub func eq(self, rhs: Alpha) bool {
		return self.x == rhs.x && self.y == rhs.y;
	}
}

impl Beta : ImplicitAs[Alpha] {
	pub func implicit_as(self) Alpha {
		return Alpha { x: self.x, y: self.y };
	}
}

func eq_generic[T: Eq[T]](a: T, b: T) bool {
	return a == b;
}

#[test("Eq constraint satisfied through ImplicitAs")]
func eqConstraintThroughImplicitAs() bool {
	return eq_generic:[Beta](Beta { x: 1, y: 2 }, Beta { x: 1, y: 2 });
}

#[test("Eq constraint through ImplicitAs - not equal")]
func eqConstraintThroughImplicitAsNotEqual() bool {
	return !eq_generic:[Beta](Beta { x: 1, y: 2 }, Beta { x: 1, y: 3 });
}
