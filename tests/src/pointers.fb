mod tests;

#[test]
func dereference() bool {
	var a = 5;
	var ptr = &a;

	return *ptr == 5;
}

#[test]
func modify() bool {
	var a = 5;

	var ptr = &a;
	*ptr = 9;

	return a == 9;
}

#[test]
func voidPointer() bool {
	var ptr: *void;
	return ptr == nil;
}

struct WrappedI32 {
	value i32;
}

#[test]
func modifyStructMember() bool {
	var wrapper = WrappedI32 {
		value: 1
	};

	var ptr = &wrapper.value;
	*ptr = 2;

	return wrapper.value == 2;
}

#[test]
func indexPointer() bool {
	var num = 3;
	var ptr = &num;
	return ptr[0] == 3;
}
