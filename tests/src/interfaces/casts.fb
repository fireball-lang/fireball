mod tests::interfaces::casts;

// Types

interface Animal {
	func get(self) i32;
	func set(mut self, foo: i32);
}

interface Foo {
	func get_true(self) bool;
}

struct Dog {
	foo: i32,
}

impl Dog : Animal {
	func get(self) i32 { return self.foo; }
	func set(mut self, foo: i32) { self.foo = foo; }
}

struct Cat {
	foo: i32,
}

impl Cat : Animal {
	func get(self) i32 { return self.foo; }
	func set(mut self, foo: i32) { self.foo = foo; }
}

impl Cat : Foo {
	func get_true(self) bool {
		return true;
	}
}

// Tests

#[test("concrete -> interface")]
func concreteToInterface() bool {
	var cat = Cat { foo: 5 };

	var animal: Animal = &cat;

	return animal.get() == 5;
}

#[test("mut concrete -> mut interface")]
func mutConcreteToMutInterface() bool {
	var cat = Cat { foo: 5 };

	var animal: mut Animal = &cat;
	animal.set(6);

	return cat.foo == 6;
}

#[test("concrete -> interface (explicit pointer cast)")]
func concreteToInterfaceExplicitPtr() bool {
	var cat = Cat { foo: 5 };

	var p: *Cat = &cat;
	var animal: Animal = p as Animal;

	return animal.get() == 5;
}

#[test("mut concrete -> mut interface (explicit mut pointer cast)")]
func mutConcreteToMutInterfaceExplicitPtr() bool {
	var cat = Cat { foo: 5 };

	var p: mut *Cat = &cat;
	var animal: mut Animal = p as mut Animal;
	animal.set(6);

	return cat.foo == 6;
}

#[test("concrete -> interface (explicit reference cast)")]
func concreteToInterfaceExplicitRef() bool {
	var cat = Cat { foo: 5 };

	var r: &Cat = &cat;
	var animal: Animal = r as Animal;

	return animal.get() == 5;
}

#[test("interface -> *concrete (valid)")]
func interfaceToPtrConcreteValid() bool {
	var cat1 = Cat { foo: 5 };

	var animal: Animal = &cat1;
	var cat2 = animal as *Cat;

	return cat2 != null && cat2.foo == 5;
}

#[test("interface -> &concrete (valid)")]
func interfaceToRefConcreteValid() bool {
	var cat1 = Cat { foo: 5 };

	var animal: Animal = &cat1;
	var cat2 = animal as &Cat;

	return cat2.is_some() && cat2.unwrap().foo == 5;
}

#[test("mut interface -> mut *concrete (valid)")]
func muInterfaceToMutPtrConcreteValid() bool {
	var cat1 = Cat { foo: 5 };

	var animal: mut Animal = &cat1;
	var cat2 = animal as mut *Cat;

	if (!(cat2 != null && cat2.foo == 5)) return false;

	cat2.foo = 6;
	return cat1.foo == 6;
}

#[test("mut interface -> mut &concrete (valid)")]
func muInterfaceToMutRefConcreteValid() bool {
	var cat1 = Cat { foo: 5 };

	var animal: mut Animal = &cat1;
	var cat2 = animal as mut &Cat;

	if (!(cat2.is_some() && cat2.unwrap().foo == 5)) return false;

	cat2.unwrap().foo = 6;
	return cat1.foo == 6;
}

#[test("interface -> *concrete (invalid)")]
func interfaceToPtrConcreteInvalid() bool {
	var cat1 = Cat { foo: 5 };

	var animal: Animal = &cat1;
	var cat2 = animal as *Dog;

	return cat2 == null;
}

#[test("interface -> &concrete (invalid)")]
func interfaceToRefConcreteInvalid() bool {
	var cat1 = Cat { foo: 5 };

	var animal: Animal = &cat1;
	var cat2 = animal as &Dog;

	return cat2.is_none();
}

#[test("mut interface -> mut *concrete (invalid)")]
func mutInterfaceToMutPtrConcreteInvalid() bool {
	var cat1 = Cat { foo: 5 };

	var animal: mut Animal = &cat1;
	var cat2 = animal as mut *Dog;

	return cat2 == null;
}

#[test("mut interface -> mut &concrete (invalid)")]
func mutInterfaceToMutRefConcreteInvalid() bool {
	var cat1 = Cat { foo: 5 };

	var animal: mut Animal = &cat1;
	var cat2 = animal as mut &Dog;

	return cat2.is_none();
}

#[test("interface -> interface (valid)")]
func interfaceToInterfaceValid() bool {
	var cat = Cat { foo: 5 };

	var animal: Animal = &cat;
	var foo = animal as Foo;

	return foo.unwrap().get_true();
}

#[test("interface -> interface (invalid)")]
func interfaceToInterfaceInvalid() bool {
	var dog = Dog { foo: 5 };

	var animal: Animal = &dog;
	var foo = animal as Foo;

	return foo.is_none();
}

#[test("mut interface -> mut interface (valid)")]
func mutInterfaceToMutInterfaceValid() bool {
	var cat = Cat { foo: 5 };

	var animal: mut Animal = &cat;
	var foo = animal as mut Foo;

	return foo.unwrap().get_true();
}

#[test("mut interface -> mut interface (invalid)")]
func mutInterfaceToMutInterfaceInvalid() bool {
	var dog = Dog { foo: 5 };

	var animal: mut Animal = &dog;
	var foo = animal as mut Foo;

	return foo.is_none();
}
