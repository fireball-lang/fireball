mod tests::arithmetic;

#[test("add")]
func testAdd() bool {
	return 2 + 3 == 5;
}

#[test("subtract")]
func testSub() bool {
	return 10 - 4 == 6;
}

#[test("multiply")]
func testMul() bool {
	return 3 * 4 == 12;
}

#[test("divide signed")]
func testDivSigned() bool {
	return -10 / 2 == -5;
}

#[test("modulo")]
func testMod() bool {
	return 10 % 3 == 1;
}

#[test("mixed size add")]
func testMixedAdd() bool {
	return 5 + 300 == 305;
}

#[test("mixed size subtract")]
func testMixedSub() bool {
	return 300 - 5 == 295;
}

#[test("mixed size multiply")]
func testMixedMul() bool {
	return 5 * 200 == 1000;
}

#[test("mixed size divide")]
func testMixedDiv() bool {
	return 1000 / 10 == 100;
}

#[test("increment prefix")]
func incPre() bool {
	var a = 5;
	return ++a == 6;
}

#[test("increment postfix")]
func incPost() bool {
	var a = 5;
	return a++ == 5;
}

#[test("decrement prefix")]
func decPre() bool {
	var a = 5;
	return --a == 4;
}

#[test("decrement postfix")]
func decPost() bool {
	var a = 5;
	return a-- == 5;
}

#[test("primitive var mixed size multiply")]
func testPrimitiveVarMul() bool {
	var a: i8 = 4;
	var b: i16 = 300;
	return a * b == 1200;
}

#[test("primitive var mixed size divide")]
func testPrimitiveVarDiv() bool {
	var a: i16 = 1000;
	var b: i8 = 10;
	return a / b == 100;
}

#[test("primitive var add sign extension")]
func testPrimitiveVarAdd() bool {
	var a: i8 = -2;
	var b: i16 = 5;
	return a + b == 3;
}

#[test("primitive var u32 bitwise")]
func testPrimitiveVarBitwise() bool {
	var a: u16 = 0x00FF;
	var b: u32 = 0x0F00;
	return (a | b) == 0x0FFF;
}
