mod tests::collision_domains;

struct foo {
    value: i32,
}

func foo(x: i32) i32 {
    return x + 1;
}

var foo: i32;

#[test("type and function with same name")]
func testTypeAndFunc() bool {
    var f = foo { value: 10 };
    return f.value == 10 && foo(5) == 6;
}

#[test("type and variable with same name")]
func testTypeAndVar() bool {
    var _f = foo { value: 10 };
    return foo == 0;
}

#[test("function and variable with same name")]
func testFuncAndVar() bool {
    return foo(10) == 11 && foo == 0;
}

#[test("all three domains with same name")]
func testAllThree() bool {
    var f = foo { value: 7 };
    return f.value == 7 && foo(3) == 4 && foo == 0;
}
