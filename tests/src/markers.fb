mod tests::markers;

// Zeroable

func get_zero[T: Zeroable]() T {
	var zero: T;
	return zero;
}

#[test("zeroable generic constraint")]
func zeroableGenericConstraint() bool {
	return get_zero:[i32]() == 0;
}

#[test("zeroable option type containing a non zeroable type")]
func zeroableOptionNonZeroableInner() bool {
	var opt: ?&i32;
	return opt.is_none();
}

#[test("null literal into option of pointer")]
func nullOptionPointer() bool {
	var opt: ?*i32 = null;
	return opt.is_some() && opt.unwrap() == null;
}
