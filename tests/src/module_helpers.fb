mod tests::module_helpers;

pub var value: i32;

pub struct Vec2 {
    pub x: i32,
    pub y: i32,
}

pub func makeVec(x: i32, y: i32) Vec2 {
    var v: Vec2;
    v.x = x;
    v.y = y;
    return v;
}

pub func add(a: i32, b: i32) i32 {
    return a + b;
}

pub func identity(v: Vec2) Vec2 {
    return v;
}

func privateGetVecOne() Vec2 {
	return makeVec(1, 1);
}
