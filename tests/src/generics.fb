mod tests::generics;

// ── Helper types ───────────────────────────────────────────────────────────────

// Two independent type params to exercise multi-param generics.
struct Pair[A, B] {
    first:  A,
    second: B,
}

impl[A, B] Pair[A, B] {
    // Read first field (covers: instance method returning type-param T from self)
    func get_first(self) A {
        return self.first;
    }

    // Read second field
    func get_second(self) B {
        return self.second;
    }

    // Mutate first field (covers: mutable receiver with type-param argument)
    func set_first(mut self, v: A) {
        self.first = v;
    }

    // Read AND write self in same method; returns old value.
    func swap_first(mut self, v: A) A {
        var old = self.first;
        self.first = v;
        return old;
    }
}

// Single-param struct for simpler field-access tests.
struct Box[T] {
    value: T,
}

impl[T] Box[T] {
	func new(value: T) Self {
		return Self { value: value };
	}

	func passthrough[K](value: K) K {
		return value;
	}

    func get(self) T {
        return self.value;
    }

    func set(mut self, v: T) {
        self.value = v;
    }
}

impl Box[i32] {
    func inc(mut self) {
        self.value++;
    }
}

// ── Helper generic functions ───────────────────────────────────────────────────

func identity[T](x: T) T {
    return x;
}

func choose[T](cond: bool, a: T, b: T) T {
    if (cond) return a;
    return b;
}

// ── Generic functions: multiple type instantiations (Bug 3 regression) ─────────
// Calling the same generic function with different concrete types must each
// produce correct results even though nodeTypes[funcNode] gets overwritten per
// instantiation during analysis.

#[test("identity i32")]
func testIdentityI32() bool {
    return identity:[i32](42) == 42;
}

#[test("identity i64")]
func testIdentityI64() bool {
    return identity:[i64](1000000000) == 1000000000;
}

#[test("identity bool")]
func testIdentityBool() bool {
    return identity:[bool](true) == true;
}

#[test("choose i32 true branch")]
func testChooseI32True() bool {
    return choose:[i32](true, 10, 20) == 10;
}

#[test("choose i32 false branch")]
func testChooseI32False() bool {
    return choose:[i32](false, 10, 20) == 20;
}

#[test("choose bool true branch")]
func testChooseBoolTrue() bool {
    return choose:[bool](true, true, false) == true;
}

#[test("choose bool false branch")]
func testChooseBoolFalse() bool {
    return choose:[bool](false, true, false) == false;
}


// ── Generic struct: field access and zero-init ─────────────────────────────────

#[test("generic struct initializer")]
func genericStructInitializer() bool {
    var b = Box:[i32] { value: 5 };
    return b.value == 5;
}

#[test("Box[i32] field write read")]
func testBoxI32() bool {
    var b: Box[i32];
    b.value = 99;
    return b.value == 99;
}

#[test("Box[i32] zero init")]
func testBoxI32Zero() bool {
    var b: Box[i32];
    return b.value == 0;
}

#[test("Pair[i32,i64] field write read")]
func testPairI32I64() bool {
    var p: Pair[i32, i64];
    p.first  = 3;
    p.second = 9000000000;
    return p.first == 3 && p.second == 9000000000;
}

#[test("Pair[i32,i32] zero init")]
func testPairZeroInit() bool {
    var p: Pair[i32, i32];
    return p.first == 0 && p.second == 0;
}

// Two different instantiations of the same struct live side-by-side; they must
// not interfere with each other's IR type or link names.
#[test("two Pair instantiations coexist")]
func testTwoPairInstances() bool {
    var a: Pair[i32, i32];
    a.first  = 1;
    a.second = 2;

    var b: Pair[i64, i32];
    b.first  = 999;
    b.second = 4;

    return a.first == 1 && a.second == 2 && b.first == 999 && b.second == 4;
}

// ── Generic struct methods: static methods ──────────

#[test("Box new static method")]
func testBoxNew() bool {
	var b = Box:[i32]::new(5);
	return b.value == 5;
}

#[test("Box passthrough static generic method")]
func testBoxPassthroughStatic() bool {
	return Box:[bool]::passthrough:[i32](3) == 3;
}

// ── Generic struct methods: instance methods ──────────

#[test("Box get method")]
func testBoxGet() bool {
    var b: Box[i32];
    b.value = 42;
    return b.get() == 42;
}

#[test("Box set method mutates field")]
func testBoxSet() bool {
    var b: Box[i32];
    b.value = 1;
    b.set(77);
    return b.value == 77;
}

#[test("Box[i32] specific inc method")]
func textBoxI32Inc() bool {
    var b: Box[i32];
    b.inc();
    return b.value == 1;
}

#[test("Pair get_first returns correct field")]
func testPairGetFirst() bool {
    var p: Pair[i32, i32];
    p.first  = 55;
    p.second = 66;
    return p.get_first() == 55;
}

#[test("Pair get_second returns correct field")]
func testPairGetSecond() bool {
    var p: Pair[i32, i64];
    p.first  = 3;
    p.second = 400;
    return p.get_second() == 400;
}

#[test("Pair set_first mutates first field only")]
func testPairSetFirst() bool {
    var p: Pair[i32, i32];
    p.first  = 1;
    p.second = 2;
    p.set_first(99);
    return p.first == 99 && p.second == 2;
}

#[test("Pair swap_first returns old, stores new")]
func testPairSwapFirst() bool {
    var p: Pair[i32, i32];
    p.first  = 10;
    p.second = 20;
    var old = p.swap_first(77);
    return old == 10 && p.first == 77 && p.second == 20;
}

// Same method called on two different instantiations — link names must differ.
#[test("get_first on two Pair instantiations")]
func testGetFirstMultipleInstances() bool {
    var a: Pair[i32, i32];
    a.first  = 7;
    a.second = 0;

    var b: Pair[i64, i32];
    b.first  = 8888;
    b.second = 0;

    return a.get_first() == 7 && b.get_first() == 8888;
}

#[test("set method on two Box instantiations")]
func testSetTwoBoxInstances() bool {
    var a: Box[i32];
    var b: Box[i64];

    a.set(11);
    b.set(22);

    return a.get() == 11 && b.get() == 22;
}

// ── Generic function + generic struct together ─────────────────────────────────

#[test("identity applied to Box[i32]")]
func testIdentityBox() bool {
    var b: Box[i32];
    b.value = 5;
    var c = identity:[Box[i32]](b);
    return c.value == 5;
}

#[test("choose between two Box[i32] values")]
func testChooseBox() bool {
    var a: Box[i32];
    var b: Box[i32];
    a.value = 1;
    b.value = 2;

    var x = choose:[Box[i32]](true,  a, b);
    var y = choose:[Box[i32]](false, a, b);

    return x.value == 1 && y.value == 2;
}

// ── Methods called via pointer variable ────────────────────────────────────────

#[test("Box get via pointer")]
func testBoxGetViaPointer() bool {
    var b: Box[i32];
    b.value = 123;
    var p = &b as *Box[i32];
    return p.get() == 123;
}

#[test("Box set via pointer affects original")]
func testBoxSetViaPointer() bool {
    var b: Box[i32];
    b.value = 0;
    var p = &b as mut *Box[i32];
    p.set(456);
    return b.value == 456;
}

#[test("Pair get_first via pointer")]
func testPairGetFirstViaPointer() bool {
    var p: Pair[i32, i32];
    p.first  = 77;
    p.second = 0;
    var ptr = &p as *Pair[i32, i32];
    return ptr.get_first() == 77;
}

// Conditional impl block dependent on generic constraint

impl[T: Eq[T]] Box[T] : Eq[Box[T]] {
	pub func eq(self, other: Self) bool {
		return self.value.eq(other.value);
	}
}

#[test("conditional impl block dependent on generic constraint")]
func implDependent() bool {
	var box = Box:[i32] { value: 5 };
	return box.eq(box);
}

// Partial implementation specializations (impl with fewer type params than the struct)
//
// `Pair` has two type params `[A, B]`; these impls fix `A = i32` and leave `B` free.

impl[B] Pair[i32, B] {
	// Method that only applies to the specialization with an i32 first field
	func double_first(self) i32 {
		return self.first * 2;
	}

	// Method using the free type param
	func get_second(self) B {
		return self.second;
	}

	func set_second(mut self, value: B) {
		self.second = value;
	}
}

#[test("partial impl: fixed-arg method")]
func testPartialImplFirst() bool {
	var p: Pair[i32, i64];
	p.first = 21;
	p.second = 7;
	return p.double_first() == 42;
}

#[test("partial impl: free-param method")]
func testPartialImplFreeParam() bool {
	var p: Pair[i32, i64];
	p.second = 123456789;
	return p.get_second() == 123456789;
}

#[test("partial impl: free-param method on a different instantiation")]
func testPartialImplFreeParamBool() bool {
	var p: Pair[i32, bool];
	p.second = true;
	return p.get_second() == true;
}

#[test("partial impl: mutating free param")]
func testPartialImplSet() bool {
	var p: Pair[i32, i64];
	p.set_second(9);
	return p.get_second() == 9;
}

// Partial impl of an interface (exercises conformance + vtable dispatch)

interface PartialGetter {
	func get(self) i32;
}

impl[B] Pair[i32, B] : PartialGetter {
	func get(self) i32 {
		return self.first;
	}
}

#[test("partial impl of interface through vtable")]
func testPartialImplInterface() bool {
	var p: Pair[i32, i64];
	p.first = 33;

	var getter: PartialGetter = &p;
	return getter.get() == 33;
}

// Operators through partial impls

impl[B] Pair[i32, B] : Neg {
	type Result = Pair[i32, B];

	pub func neg(self) Pair[i32, B] {
		return Pair:[i32, B] { first: -self.first, second: self.second };
	}
}

impl[B] Pair[i32, B] : Add[Pair[i32, B]] {
	type Result = Pair[i32, B];

	pub func add(self, rhs: Pair[i32, B]) Pair[i32, B] {
		return Pair:[i32, B] { first: self.first + rhs.first, second: rhs.second };
	}
}

impl[B] Pair[i32, B] : Eq[Pair[i32, B]] {
	pub func eq(self, rhs: Pair[i32, B]) bool {
		return self.first == rhs.first;
	}
}

#[test("partial impl: unary operator - (Neg)")]
func testPartialNeg() bool {
	var p = -Pair:[i32, i64] { first: 3, second: 5 };
	return p.first == -3 && p.second == 5;
}

#[test("partial impl: unary operator - on a different instantiation")]
func testPartialNegBool() bool {
	var p = -Pair:[i32, bool] { first: 3, second: true };
	return p.first == -3 && p.second == true;
}

#[test("partial impl: binary operator + (Add)")]
func testPartialAdd() bool {
	var p = Pair:[i32, i64] { first: 10, second: 1 } + Pair:[i32, i64] { first: 5, second: 2 };
	return p.first == 15 && p.second == 2;
}

#[test("partial impl: equality operator ==")]
func testPartialEqEqual() bool {
	return Pair:[i32, i64] { first: 7, second: 1 } == Pair:[i32, i64] { first: 7, second: 9 };
}

#[test("partial impl: inequality operator !=")]
func testPartialEqNotEqual() bool {
	return Pair:[i32, i64] { first: 7, second: 1 } != Pair:[i32, i64] { first: 8, second: 9 };
}

// Nested generic instantiation: a method on a generic struct whose field is
// itself a generic instantiation with a type param (e.g. ArrayList[Item[K, V]]).
// Regression test for a double-instantiation that left type params in the
// instantiated method's signature and crashed ABI layout.

struct Boxed[T] {
	value: T,
}

impl[T] Boxed[T] {
	func get(self) T {
		return self.value;
	}
}

struct OuterBox[A, B] {
	inner: Boxed[A],
	tag:   B,
}

impl[A, B] OuterBox[A, B] {
	func read_inner(self) A {
		return self.inner.get();
	}

	func read_inner_twice(self) A {
		return self.read_inner();
	}
}

#[test("nested generic method call through parent instantiation")]
func testNestedGenericCall() bool {
	var o = OuterBox:[i32, i64] {
		inner: Boxed:[i32] { value: 42 },
		tag:   7,
	};
	return o.read_inner() == 42;
}

#[test("nested generic method call on another instantiation")]
func testNestedGenericCallBool() bool {
	var o = OuterBox:[bool, i32] {
		inner: Boxed:[bool] { value: true },
		tag:   3,
	};
	return o.read_inner() == true;
}

#[test("nested generic method call through a second generic method")]
func testNestedGenericCallTwice() bool {
	var o = OuterBox:[i32, i64] {
		inner: Boxed:[i32] { value: 99 },
		tag:   1,
	};
	return o.read_inner_twice() == 99;
}
