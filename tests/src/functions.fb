mod tests::functions;

func add(a: i32, b: i32) i32 {
    return a + b;
}

func factorial(n: i32) i32 {
    if (n <= 1) { return 1; }
    return n * factorial(n - 1);
}

#[test("call with args")]
func testCall() bool {
	return add(3, 4) == 7;
}

#[test("recursion")]
func testRecursion() bool {
	return factorial(5) == 120;
}

// --- function references ---

func is_positive(v: i32) bool {
	return v > 0;
}

struct Wrapper[T] {
	value: T,
}

impl[T] Wrapper[T] {
	func get(self) T {
		return self.value;
	}

	func set(mut self, v: T) {
		self.value = v;
	}
}

// Higher-order helper: takes a function reference as an argument.
func apply(callback: func(i32) bool, v: i32) bool {
	return callback(v);
}

// Returns a function reference.
func makePred() func(i32) bool {
	return is_positive;
}

// Struct holding a function reference in a field.
struct CallbackHolder {
	pred: func(i32) bool,
}

#[test("call function reference")]
func callFunctionReference() bool {
	var fn: func(i32) bool = is_positive;
	return fn(5);
}

#[test("call function reference assigned from a method")]
func methodFunctionReference() bool {
	var wrapper = Wrapper:[i32] { value: 5 };
	var fn = wrapper.get;
	return fn(&wrapper) == 5;
}

#[test("function reference with explicit type annotation and multiple args")]
func funcRefTypeAnnotation() bool {
	var pred: func(i32) bool = is_positive;
	var addFn: func(i32, i32) i32 = add;

	return pred(5) && addFn(2, 3) == 5;
}

#[test("function reference passed as an argument (higher-order)")]
func funcRefAsArgument() bool {
	var pred: func(i32) bool = is_positive;
	return apply(pred, 5) && apply(is_positive, -3) == false;
}

#[test("mutable method assigned to function reference")]
func mutableMethodFunctionReference() bool {
	var wrapper = Wrapper:[i32] { value: 5 };
	var setter: func(mut &Wrapper[i32], i32) = wrapper.set;
	setter(&wrapper, 9);

	var getter: func(&Wrapper[i32]) i32 = wrapper.get;
	return getter(&wrapper) == 9;
}

#[test("function returning a function reference")]
func funcRefReturn() bool {
	var pred = makePred();
	return pred(4);
}

#[test("function reference stored in a struct field")]
func funcRefInStructField() bool {
	var h = CallbackHolder { pred: is_positive };
	return h.pred(7);
}

struct NamedHolder {
	run: func(i32) i32,
}

func doubleIt(v: i32) i32 {
	return v * 2;
}

#[test("function reference field takes precedence over same-named method when called")]
func funcRefFieldOverMethod() bool {
	var h = NamedHolder { run: doubleIt };
	return h.run(21) == 42;
}

func sum(a: i32, b: i32) i32 {
	return a + b;
}

#[test("optional function reference")]
func optionalFuncRef() bool {
	var none: ?func(i32, i32) i32;
	if (!none.is_none()) return false;

	var some: ?func(i32, i32) i32 = sum;
	if (!some.is_some()) return false;

	return some.unwrap()(2, 3) == 5;
}
