mod tests::functions;

func add(a: i32, b: i32) i32 {
    return a + b;
}

func factorial(n: i32) i32 {
    if (n <= 1) { return 1; }
    return n * factorial(n - 1);
}

#[test("call with args")]
func testCall() bool {
	return add(3, 4) == 7;
}

#[test("recursion")]
func testRecursion() bool {
	return factorial(5) == 120;
}

// --- function pointers ---

func is_positive(v: i32) bool {
	return v > 0;
}

struct Wrapper[T] {
	value: T,
}

impl[T] Wrapper[T] {
	func get(self) T {
		return self.value;
	}

	func set(mut self, v: T) {
		self.value = v;
	}
}

// Higher-order helper: takes a function pointer as an argument.
func apply(callback: func(i32) bool, v: i32) bool {
	return callback(v);
}

// Returns a function pointer.
func makePred() func(i32) bool {
	return is_positive;
}

// Struct holding a function pointer in a field.
struct CallbackHolder {
	pred: func(i32) bool,
}

#[test("call function pointer")]
func callFunctionPointer() bool {
	var fn: func(i32) bool = is_positive;
	return fn(5);
}

#[test("call function pointer assigned from a method")]
func methodFunctionPointer() bool {
	var wrapper = Wrapper:[i32] { value: 5 };
	var fn = wrapper.get;
	return fn(&wrapper) == 5;
}

#[test("function pointer with explicit type annotation and multiple args")]
func funcPointerTypeAnnotation() bool {
	var pred: func(i32) bool = is_positive;
	var addFn: func(i32, i32) i32 = add;

	return pred(5) && addFn(2, 3) == 5;
}

#[test("function pointer passed as an argument (higher-order)")]
func funcPointerAsArgument() bool {
	var pred: func(i32) bool = is_positive;
	return apply(pred, 5) && apply(is_positive, -3) == false;
}

#[test("mutable method assigned to function pointer")]
func mutableMethodFunctionPointer() bool {
	var wrapper = Wrapper:[i32] { value: 5 };
	var setter: func(mut &Wrapper[i32], i32);
	setter = wrapper.set;
	setter(&wrapper, 9);

	var getter: func(&Wrapper[i32]) i32;
	getter = wrapper.get;
	return getter(&wrapper) == 9;
}

#[test("function returning a function pointer")]
func funcPointerReturn() bool {
	var pred = makePred();
	return pred(4);
}

#[test("function pointer stored in a struct field")]
func funcPointerInStructField() bool {
	var h: CallbackHolder;
	h.pred = is_positive;
	return h.pred(7);
}

struct NamedHolder {
	run: func(i32) i32,
}

func doubleIt(v: i32) i32 {
	return v * 2;
}

#[test("function pointer field takes precedence over same-named method when called")]
func funcPointerFieldOverMethod() bool {
	var h: NamedHolder;
	h.run = doubleIt;
	return h.run(21) == 42;
}
