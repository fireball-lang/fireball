mod tests::match_statements;

func classify(value: i32) i32 {
    var result = 0;

    match (value) {
        1 => result = 10;
        2, 3, 4 => result = 20;
        5 => result = 30;
        _ => result = 40;
    }

    return result;
}

#[test("match dispatch and multiple patterns")]
func testDispatch() bool {
    return classify(1) == 10
        && classify(2) == 20
        && classify(3) == 20
        && classify(4) == 20
        && classify(5) == 30
        && classify(6) == 40;
}

struct Key {
    id: i32,
    ignored: i32,
}

var subjectCalls: i32 = 0;
var comparisonTrace: i32 = 0;

impl Key : Eq[Key] {
    pub func eq(self, rhs: Key) bool {
        comparisonTrace = comparisonTrace * 10 + rhs.id;
        return self.id == rhs.id;
    }
}

func nextKey() Key {
    subjectCalls++;
    return Key { id: 2, ignored: 99 };
}

#[test("match evaluates once and short circuits equality")]
func testEvaluationOrder() bool {
    subjectCalls = 0;
    comparisonTrace = 0;
    var result = 0;

    match (nextKey()) {
        Key { id: 1, ignored: 0 } => result = 1;
        Key { id: 2, ignored: 0 }, Key { id: 3, ignored: 0 } => result = 2;
        Key { id: 4, ignored: 0 } => result = 3;
        _ => result = 4;
    }

    return result == 2 && subjectCalls == 1 && comparisonTrace == 12;
}

#[test("match equality receivers for local and temporary values")]
func testReceivers() bool {
    var key = Key { id: 2, ignored: 99 };
    var result = 0;

    match (key) {
        Key { id: 2, ignored: 0 } => result = result + 1;
        _ => {}
    }

    match (Key { id: 2, ignored: 99 }) {
        Key { id: 2, ignored: 0 } => result = result + 2;
        _ => {}
    }

    return result == 3 && key.ignored == 99;
}

struct OptionalKey {
    id: i32,
}

impl OptionalKey : Eq[?OptionalKey] {
    pub func eq(self, rhs: ?OptionalKey) bool {
        if (rhs.is_none()) return false;
        var other = rhs.unwrap();
        return self.id == other.id;
    }
}

#[test("match converts patterns to equality parameter type")]
func testEqualityArgumentConversion() bool {
    var key = OptionalKey { id: 0 };
    var result = 0;

    // Equality must receive Some(pattern), not the raw OptionalKey value.
    match (key) {
        OptionalKey { id: 1 } => result = 1;
        OptionalKey { id: 0 } => result = 2;
        _ => result = 3;
    }

    return result == 2;
}

func booleanValue(value: bool) i32 {
    var result = 0;

    match (value) {
        false => result = 1;
        true => result = 2;
    }

    return result;
}

#[test("match exhaustive boolean arms")]
func testBoolean() bool {
    return booleanValue(false) == 1 && booleanValue(true) == 2;
}

func nestedValue(value: i32) i32 {
    match (value) {
        2 => return 10;
        _ => {}
    }

    return 100;
}

#[test("match nested control flow preserves loop targets")]
func testLoopControl() bool {
    var result = 0;

    for (var i = 0; i < 5; i++) {
        match (i) {
            0 => continue;
            1 => result = result + 1;
            _ => match (i) {
                2 => result = result + nestedValue(i);
                _ => break;
            }
        }

        result = result + 100;
    }

    return result == 211;
}

#[test("match fallback only evaluates subject and isolates locals")]
func testFallbackOnly() bool {
    subjectCalls = 0;

    var value = 7;
    var result = 0;

    match (nextKey()) {
        _ => {
            var value = 9;
            result = value;
        }
    }

    return subjectCalls == 1 && result == 9 && value == 7;
}

union MatchEvent {
    Empty {};
    Number { value: i32 };
    Pair { small: i32, wide: i64 };
}

func classifyEvent(event: MatchEvent) i32 {
    // Arm order differs from tag order; the last arm still binds a payload.
    match (event) {
        MatchEvent::Pair {} => return 2;
        MatchEvent::Empty {} => return 0;
        MatchEvent::Number { n: value } => return n;
    }
}

#[test("union match dispatches exhaustively in arm order")]
func testUnionDispatch() bool {
    return classifyEvent(MatchEvent::Empty {}) == 0
        && classifyEvent(MatchEvent::Number { value: 47 }) == 47
        && classifyEvent(MatchEvent::Pair { small: 13, wide: 29 }) == 2;
}

#[test("union match binds only the requested field at its layout offset")]
func testUnionPartialBinding() bool {
    // The wider field is laid out first, despite being declared second.
    match (MatchEvent::Pair { small: -17, wide: 0x1020304050607080 as i64 }) {
        MatchEvent::Pair { n: small } => return n == -17;
        _ => return false;
    }
}

func nextEvent(calls: mut &i32) MatchEvent {
    *calls = *calls + 1;
    return MatchEvent::Empty {};
}

#[test("union match evaluates the scrutinee once before taking fallback")]
func testUnionFallback() bool {
    var calls = 0;
    match (nextEvent(&calls)) {
        MatchEvent::Number {} => return false;
        MatchEvent::Pair {} => return false;
        _ => return calls == 1;
    }
}

union MatchBox[T] {
    Empty {};
    Value { value: T };
}

func unpackMatchBox[T](box: MatchBox[T], fallback: T) T {
    match (box) {
        MatchBox:[T]::Value { item: value } => return item;
        MatchBox:[T]::Empty {} => return fallback;
    }
}

#[test("union match specializes binding types in generic code")]
func testUnionGenericBinding() bool {
    var small = MatchBox:[i32]::Value { value: -37 };
    var large = MatchBox:[i64]::Value { value: 0x1020304050607080 as i64 };
    return unpackMatchBox:[i32](small, 0) == -37
        && unpackMatchBox:[i64](large, 0) == (0x1020304050607080 as i64);
}

#[test("union match bindings are copies of the payload")]
func testUnionBindingCopy() bool {
    var event = MatchEvent::Number { value: 23 };
    var changed = 0;

    match (event) {
        MatchEvent::Number { n: value } => {
            n = n + 100;
            changed = n;
        }
        _ => return false;
    }

    return changed == 123 && classifyEvent(event) == 23;
}

#[test("nested union matches restore outer binding and local scopes")]
func testUnionNestedScopes() bool {
    var base = 100;
    var result = 0;

    match (MatchEvent::Number { value: 7 }) {
        MatchEvent::Number { n: value } => {
            match (MatchEvent::Number { value: 3 }) {
                MatchEvent::Number { n: value } => result = n;
                _ => return false;
            }
            result = result * 10 + n;
        }
        _ => return false;
    }

    return base + result == 137;
}

#[test("union match preserves loop targets")]
func testUnionLoopControl() bool {
    var total = 0;

    for (var i = 0; i < 5; i++) {
        var event = MatchEvent::Number { value: i };
        if (i == 0) event = MatchEvent::Empty {};
        if (i == 3) event = MatchEvent::Pair { small: 0, wide: 0 };

        match (event) {
            MatchEvent::Empty {} => continue;
            MatchEvent::Number { n: value } => total = total + n;
            MatchEvent::Pair {} => break;
        }

        total = total + 10;
    }

    return total == 23;
}

union ComparableEvent {
    First {};
    Second {};
}

var unionEqualityCalls: i32 = 0;

impl ComparableEvent : Eq[ComparableEvent] {
    pub func eq(self, _rhs: ComparableEvent) bool {
        unionEqualityCalls++;
        return false;
    }
}

#[test("union case matching does not call Eq")]
func testUnionIgnoresEquality() bool {
    unionEqualityCalls = 0;
    match (ComparableEvent::First {}) {
        ComparableEvent::First {} => return unionEqualityCalls == 0;
        ComparableEvent::Second {} => return false;
    }
}
