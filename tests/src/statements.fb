mod tests;

#[test]
func variableZeroInit() bool {
    var n: i32;
    var b: bool;

    return n == 0 && !b;
}

#[test]
func variableShadowing() bool {
    var a = 3;

    {
        var a = 6;
        a = 9;

        if (a != 9)
            return false;
    }

    return a == 3;
}

#[test]
func if() bool {
    if (true)
        return true;

    return false;
}

#[test]
func else() bool {
    if (false) return false;
    else return true;

    return false;
}

#[test]
func while() bool {
    var a = 0;

    while (a < 5) {
        a++;
	}

    return a == 5;
}

#[test("for - all clauses")]
func for1() bool {
    var a = 0;

    for (var i = 0; i < 4; i++) {
        a++;
	}

    return a == 4;
}

#[test("for - no initializer")]
func for2() bool {
    var a = 0;

    for (; a < 4; a++) { }

    return a == 4;
}

#[test("for - no increment")]
func for3() bool {
    var a = 0;

    for (var i = 0; i < 4;) {
        i++;
        a++;
	}

    return a == 4;
}

#[test]
func whileBreak() bool {
	var i = 0;

	while (true) {
		if (i == 3)
			break;

		i++;
	}

	return i == 3;
}

#[test]
func forBreak() bool {
	var i = 0;

	for (;; i++) {
		if (i == 4)
			break;
	}

	return i == 4;
}

#[test]
func whileContinue() bool {
	var i = 0;
	var j = 0;

	while (i < 3) {
		i++;

		if (i == 1)
			continue;

		j++;
	}

	return i == 3 && j == 2;
}

#[test]
func forContinue() bool {
	var i = 0;
	var j = 0;

	for (; i < 3; i++) {
		if (i == 1)
			continue;

		j++;
	}

	return i == 3 && j == 2;
}
