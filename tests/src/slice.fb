mod tests::slice;

struct Vec3 {
	xyz: [3]i32,
}

#[test("addressable array -> slice (implicit, var)")]
func arrayToSliceImplicitVar() bool {
	var array = [3]i32 { 2, 5, 9 };
	var slice: []i32 = array;

	return slice.size == 3u && slice[1u] == 5;
}

#[test("addressable array -> slice (implicit, field)")]
func arrayToSliceImplicitField() bool {
	var point = Vec3 { xyz: [3]i32 { 2, 5, 9 } };
	var slice: []i32 = point.xyz;

	return slice.size == 3u && slice[1u] == 5;
}

// --- Slice methods ---

#[test("Slice.is_empty - non-empty")]
func sliceIsEmpty() bool {
	var array = [3]i32 { 1, 2, 3 };
	var slice: []i32 = array;
	return !slice.is_empty();
}

#[test("Slice.first - non-empty")]
func sliceFirst() bool {
	var array = [3]i32 { 10, 20, 30 };
	var slice: []i32 = array;
	return slice.first().unwrap() == 10;
}

#[test("Slice.first - empty")]
func sliceFirstEmpty() bool {
	var slice: []i32;
	return slice.first().is_none();
}

#[test("Slice.last - non-empty")]
func sliceLast() bool {
	var array = [3]i32 { 10, 20, 30 };
	var slice: []i32 = array;
	return slice.last().unwrap() == 30;
}

#[test("Slice.last - empty")]
func sliceLastEmpty() bool {
	var slice: []i32;
	return slice.last().is_none();
}

#[test("Slice.slice - sub-slice")]
func sliceSlice() bool {
	var array = [4]i32 { 10, 20, 30, 40 };
	var s: []i32 = array;
	var sub = s.slice(1u, 3u);
	return sub.size == 2u && sub[0u] == 20 && sub[1u] == 30;
}

#[test("Slice.offset - from index")]
func sliceOffset() bool {
	var array = [4]i32 { 10, 20, 30, 40 };
	var s: []i32 = array;
	var rest = s.offset(2u);
	return rest.size == 2u && rest[0u] == 30 && rest[1u] == 40;
}

// --- MutSlice methods ---

#[test("MutSlice.is_empty")]
func mutSliceIsEmpty() bool {
	var array = [3]i32 { 1, 2, 3 };
	var slice: mut []i32 = array;
	return !slice.is_empty();
}

#[test("MutSlice.first")]
func mutSliceFirst() bool {
	var array = [3]i32 { 10, 20, 30 };
	var slice: mut []i32 = array;
	return slice.first().unwrap() == 10;
}

#[test("MutSlice.last")]
func mutSliceLast() bool {
	var array = [3]i32 { 10, 20, 30 };
	var slice: mut []i32 = array;
	return slice.last().unwrap() == 30;
}

#[test("MutSlice.slice - sub-slice")]
func mutSliceSlice() bool {
	var array = [4]i32 { 10, 20, 30, 40 };
	var s: mut []i32 = array;
	var sub = s.slice(1u, 3u);
	return sub.size == 2u && sub[0u] == 20 && sub[1u] == 30;
}

#[test("MutSlice.offset - from index")]
func mutSliceOffset() bool {
	var array = [4]i32 { 10, 20, 30, 40 };
	var s: mut []i32 = array;
	var rest = s.offset(2u);
	return rest.size == 2u && rest[0u] == 30 && rest[1u] == 40;
}

#[test("MutSlice.fill")]
func mutSliceFill() bool {
	var array = [4]i32 { 1, 2, 3, 4 };
	var s: mut []i32 = array;
	s.fill(7);
	return s[0u] == 7 && s[1u] == 7 && s[2u] == 7 && s[3u] == 7;
}

#[test("MutSlice.swap")]
func mutSliceSwap() bool {
	var array = [3]i32 { 10, 20, 30 };
	var s: mut []i32 = array;
	s.swap(0u, 2u);
	return s[0u] == 30 && s[2u] == 10;
}

#[test("MutSlice.reverse - empty")]
func mutSliceReverseEmpty() bool {
	var slice: mut []i32;
	slice.reverse();
	return true;
}

#[test("MutSlice.reverse - single element")]
func mutSliceReverseSingle() bool {
	var array = [1]i32 { 42 };
	var s: mut []i32 = array;
	s.reverse();
	return s[0u] == 42;
}

#[test("MutSlice.reverse - 3 elements")]
func mutSliceReverse() bool {
	var array = [3]i32 { 1, 2, 3 };
	var s: mut []i32 = array;
	s.reverse();
	return s[0u] == 3 && s[1u] == 2 && s[2u] == 1;
}
