mod tests::literals;

#[test("binary literal")]
func testBinLit() bool {
	return 0b1010 == 10u;
}

#[test("hex literal")]
func testHexLit() bool {
	return 0xFF == 255u;
}

#[test("char literal")]
func testCharLit() bool {
	return 'A' == 65u;
}

#[test("char literal fits in u8")]
func testCharLitU8() bool {
	var ch: u8 = 'a';
	return ch == 'a';
}

#[test("f32 literal")]
func testF32Lit() bool {
	return 1.0f == 1.0f;
}

#[test("null pointer")]
func testNull() bool {
	var ptr: *i32;
	return ptr == null;
}
