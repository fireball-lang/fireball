mod tests::structs;

struct Vec2 {
    x: i32,
    y: i32,
}

func makeVec(x: i32, y: i32) Vec2 {
    var v: Vec2;
    v.x = x;
    v.y = y;
    return v;
}

// Returns its argument as a temporary *Vec2 (non-addressable call result)
func asVecPtr(v: *Vec2) *Vec2 {
    return v;
}

// Writes to a field through a pointer parameter
func setVecX(v: mut *Vec2, x: i32) {
    v.x = x;
}

func setVecY(v: mut *Vec2, y: i32) {
    v.y = y;
}

// Reads a field through a pointer parameter
func getVecX(v: *Vec2) i32 {
    return v.x;
}

// ── direct struct, addressable ────────────────────────────────────────────────

#[test("struct initializer")]
func structInitializer() bool {
    var v = Vec2 { x: 1 };
    return v.x == 1 && v.y == 0;
}

#[test("struct field read (direct, addressable)")]
func testStructFieldRead() bool {
    var v = makeVec(3, 4);
    return v.x == 3 && v.y == 4;
}

#[test("struct field write (direct, addressable)")]
func testStructFieldWrite() bool {
    var v: Vec2;
    v.x = 7;
    v.y = 11;
    return v.x == 7 && v.y == 11;
}

#[test("struct zero init")]
func testStructZero() bool {
    var v: Vec2;
    return v.x == 0 && v.y == 0;
}

// ── direct struct, temporary (function return value) ─────────────────────────

#[test("struct field read (direct, temporary)")]
func testTempStructFieldRead() bool {
    return makeVec(3, 4).x == 3 && makeVec(3, 4).y == 4;
}

// ── pointer to struct, addressable ptr ───────────────────────────────────────

#[test("struct field read (pointer, addressable)")]
func testPtrStructFieldRead() bool {
    var v = makeVec(3, 4);
    var p = &v as mut *Vec2;
    return p.x == 3 && p.y == 4;
}

#[test("struct field write (pointer, addressable)")]
func testPtrStructFieldWrite() bool {
    var v: Vec2;
    var p = &v as mut *Vec2;
    p.x = 9;
    p.y = 13;
    return v.x == 9 && v.y == 13;
}

// ── pointer to struct, temporary ptr (function return value) ─────────────────

#[test("struct field read (pointer, temporary)")]
func testTempPtrStructFieldRead() bool {
    var v = makeVec(5, 6);
    return asVecPtr(&v).x == 5 && asVecPtr(&v).y == 6;
}

// ── through pointer parameter ─────────────────────────────────────────────────

#[test("struct field write via pointer param")]
func testPtrParamStructFieldWrite() bool {
    var v: Vec2;
    setVecX(&v, 42);
    setVecY(&v, 99);
    return v.x == 42 && v.y == 99;
}

#[test("struct field read via pointer param")]
func testPtrParamStructFieldRead() bool {
    var v = makeVec(7, 8);
    return getVecX(&v) == 7;
}

// ── self-referential struct (linked list) ─────────────────────────────────────

struct Node {
    value: i32,
    next: *Node,
}

#[test("self-referential struct field read (linked list)")]
func testLinkedList() bool {
    var a: Node;
    var b: Node;
    var c: Node;

    a.value = 1;
    b.value = 2;
    c.value = 3;

    a.next = &b;
    b.next = &c;
    c.next = null;

    return a.value == 1 && a.next.value == 2 && a.next.next.value == 3 && a.next.next.next == null;
}

// ── with expression (copy-modify) ─────────────────────────────────────────────

#[test("with: copy with field replaced")]
func testWithFieldReplaced() bool {
    var w = makeVec(3, 4) with { x: 99 };
    return w.x == 99 && w.y == 4;
}

#[test("with: replaces multiple fields")]
func testWithMultipleFields() bool {
    var w = makeVec(1, 2) with { x: 10, y: 20 };
    return w.x == 10 && w.y == 20;
}

#[test("with: original value unchanged (copy)")]
func testWithIsCopy() bool {
    var v = makeVec(3, 4);
    var w = v with { x: 10 };
    return w.x == 10 && w.y == 4 && v.x == 3 && v.y == 4;
}

#[test("with: on a non-addressable temporary")]
func testWithOnTemporary() bool {
    return (makeVec(5, 6) with { x: 1 }).x == 1 && (makeVec(5, 6) with { x: 1 }).y == 6;
}

#[test("with: chained")]
func testWithChained() bool {
    var w = makeVec(1, 2) with { x: 10 } with { y: 20 };
    return w.x == 10 && w.y == 20;
}

#[test("with: on a struct variable with a pointer field")]
func testWithPointerField() bool {
    var a: Node;
    var b: Node;
    a.value = 1;
    b.value = 2;
    a.next = &b;

    var w = a with { value: 50 };
    return w.value == 50 && w.next.value == 2 && a.value == 1;
}

// Mixed field sizes so the ABI layout order differs from the declaration order.
// Declared: a(i8), b(i64), c(i32) — sorted by alignment in the Fireball layout.
struct MixedSize {
    a: i8,
    b: i64,
    c: i32,
}

func makeMixed(a: i8, b: i64, c: i32) MixedSize {
    var m: MixedSize;
    m.a = a;
    m.b = b;
    m.c = c;
    return m;
}

#[test("with: field reordered by ABI layout")]
func testWithReorderedFields() bool {
    var w = makeMixed(1, 1000, 200) with { c: 300 };
    return w.a == 1 && w.b == 1000 && w.c == 300;
}

#[test("with: multiple reordered fields")]
func testWithReorderedFieldsMultiple() bool {
    var w = makeMixed(1, 1000, 200) with { a: 9, b: 9000 };
    return w.a == 9 && w.b == 9000 && w.c == 200;
}
