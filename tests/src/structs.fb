mod tests;

struct Vec2 {
	x i32;
	y i32;
}

impl Vec2 {
	static func new(x i32, y i32) Vec2 {
		return Vec2 { x: x, y: y };
	}

	func max() i32 {
		if (this.x > this.y) return this.x;
		return this.y;
	}

	func set_x(x i32) {
		this.x = x;
	}
}

#[test]
func memberValueStruct() bool {
	return Vec2 { x: 2, y: 4 }.y == 4;
}

#[test]
func memberAddressStruct() bool {
	var v = Vec2 { x: 1, y: 6 };
	return v.y == 6;
}

#[test]
func memberThroughPointerStruct() bool {
	var v = Vec2 { x: 1, y: 2 };

	var ptr = &v;
	ptr.y = 3;

	return (&v).y == 3;
}

#[test]
func methodValueStruct() bool {
	return Vec2 { x: 3, y: 6 }.max() == 6;
}

#[test]
func methodAddressStruct() bool {
	var v = Vec2 { x: 3, y: 6 };
	return v.max() == 6;
}

#[test]
func methodModifyReceiver() bool {
	var v = Vec2 { x: 6, y: 5 };
	v.set_x(5);

	return v.x == 5;
}

#[test]
func staticMethod() bool {
	return Vec2.new(3, 2).y == 2;
}

// Packed

#[packed]
struct PackedStruct {
	a u16;
	b u32;
}

#[test]
func packedStruct() bool {
	return sizeof(PackedStruct) == 6u;
}

// Nested method

impl Vec2 {
	func get_x() i32 {
		return this.x;
	}

	func get_y() i32 {
		return this.y;
	}

	func sum() i32 {
		return this.get_x() + this.get_y();
	}
}

#[test]
func nestedMethodCall() bool {
	var v = Vec2 { x: 1, y: 3 };
	return v.sum() == 4;
}
