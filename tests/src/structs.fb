mod tests;

struct Vec2 {
	x i32;
	y i32;
}

impl Vec2 {
	static func new(x i32, y i32) Vec2 {
		return Vec2 { x: x, y: y };
	}

	func max() i32 {
		if (this.x > this.y) return this.x;
		return this.y;
	}
}

#[test]
func memberValueStruct() bool {
	return Vec2 { x: 2, y: 4 }.y == 4;
}

#[test]
func memberAddressStruct() bool {
	var v = Vec2 { x: 1, y: 6 };
	return v.y == 6;
}

#[test]
func memberThroughPointerStruct() bool {
	var v = Vec2 { x: 1, y: 2 };

	var ptr = &v;
	ptr.y = 3;

	return (&v).y == 3;
}

#[test]
func methodValueStruct() bool {
	return Vec2 { x: 3, y: 6 }.max() == 6;
}

#[test]
func methodAddressStruct() bool {
	var v = Vec2 { x: 3, y: 6 };
	return v.max() == 6;
}

#[test]
func staticMethod() bool {
	return Vec2.new(3, 2).y == 2;
}
