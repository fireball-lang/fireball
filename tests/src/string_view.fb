mod tests::string_view;

#[test("StringView::starts_with() - true")]
func startsWithTrue() bool {
	return "Hello, World!".starts_with("Hello");
}

#[test("StringView::starts_with() - false")]
func startsWithFalse() bool {
	return !"Hello, World!".starts_with("ello");
}

#[test("StringView::ends_with() - true")]
func endsWithTrue() bool {
	return "Hello, World!".ends_with("World!");
}

#[test("StringView::ends_with() - false")]
func endsWithFalse() bool {
	return !"Hello, World!".ends_with("World");
}

#[test("StringView::contains() - true")]
func containsTrue() bool {
	return "Hello, World!".contains("o, W");
}

#[test("StringView::contains() - false")]
func containsFalse() bool {
	return !"Hello, World!".contains("o W");
}

#[test("StringView::index_of() - True")]
func indexOfTrue() bool {
	return "Hello, World!".index_of("l") == 2;
}

#[test("StringView::index_of() - False")]
func indexOfFalse() bool {
	return "Hello, World!".index_of("l") != 3;
}

#[test("StringView::index_of_last() - True")]
func indexOfLastTrue() bool {
	return "Hello, World!".index_of_last("l") == 10;
}

#[test("StringView::index_of_last() - False")]
func indexOfLastFalse() bool {
	return "Hello, World!".index_of_last("l") != 11;
}

#[test("StringView::trim()")]
func trim() bool {
	return "  Hello, World!\t".trim().size == 13u;
}

#[test("StringView::eq() - True")]
func eqTrue() bool {
	return "1".eq("1");
}

#[test("StringView::eq() - False")]
func eqFalse() bool {
	return !"1".eq("2");
}

#[test("StringView::[]")]
func index() bool {
	return "Hello"[2u] == 'l';
}
