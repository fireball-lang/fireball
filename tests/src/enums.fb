mod tests;

enum Animal {
	None,
	Cat = 6,
	Dog,
	Mouse = -2,
	Rat
}

impl Animal {
	func is_valid() bool {
		return *this != Animal.None;
	}
}

#[test]
func enumCastToInt() bool {
	return Animal.Rat as i32 == -1;
}

#[test]
func intCastToEnum() bool {
	return 7 as Animal == Animal.Dog;
}

#[test]
func enumMethod() bool {
	return Animal.Cat.is_valid();
}
