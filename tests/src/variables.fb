mod tests::variables;

#[test("var zero init")]
func testVarZeroInit() bool {
    var x: i32;
    return x == 0;
}

#[test("var infer type")]
func testVarInfer() bool {
    var x = 42;
    return x == 42;
}

#[test("var reassign")]
func testVarReassign() bool {
    var x = 1;
    x = 2;
    return x == 2;
}

#[test("var infer defaults to i32")]
func testVarInferDefaultsI32() bool {
    // If x were inferred as i8, reassigning 100000 (i32) would fail sema
    // since there is no implicit narrowing cast. This only compiles if x is i32.
    var x = 5;
    x = 100000;
    return x == 100000;
}

#[test("var infer large literal")]
func testVarInferLarge() bool {
    var x = 100000;
    return x == 100000;
}
