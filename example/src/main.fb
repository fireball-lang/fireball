mod example;

import example::c::{printf};

func main() {
    var os = get_os();
    printf("Hello from %s!\n".ptr, os.ptr);
}

#[cfg(target_os = "windows")]
func get_os() StringView {
    return "Windows";
}

#[cfg(target_os = "linux")]
func get_os() StringView {
    return "Linux";
}

#[cfg(target_os = "macos")]
func get_os() StringView {
    return "MacOS";
}
